config HW75_LAMPARRAY
	bool "HID LampArray (Windows Dynamic Lighting)"
	default n
	depends on ZMK_RGB_UNDERGLOW
	depends on USB_DEVICE_HID
	select HW75_USB_COMM_FEATURE_LAMPARRAY if HW75_USB_COMM
	help
	  Expose an additional USB HID interface implementing the Microsoft
	  HID LampArray usage page (0x59) so that Windows 11 Dynamic Lighting
	  can drive the LEDs. When the host takes control, the autonomous
	  ZMK RGB underglow worker and (on hw75_dynamic) the status indicator
	  are paused so the host has exclusive control of the LEDs.

if HW75_LAMPARRAY

config HW75_LAMPARRAY_DEVICE_NAME
	string "Name of USB HID device to be used for LampArray"
	default "HID_2" if BOARD_HW75_KEYBOARD
	default "HID_3" if BOARD_HW75_DYNAMIC

config HW75_LAMPARRAY_AUTONOMOUS_ON_BOOT
	bool "Start in autonomous mode on firmware boot"
	help
	  When y, the LampArray interface boots in autonomous mode (firmware
	  controls the LEDs). Windows taking control will still switch into
	  slave mode. When n, the LampArray boots in slave mode (Windows
	  controls the LEDs as soon as the host is ready).

module = HW75_LAMPARRAY
module-str = lamparray
source "subsys/logging/Kconfig.template.log_config"

endif # HW75_LAMPARRAY

# Number of USB HID device instances the Zephyr HID class driver should
# create. Defaults to 1 (just ZMK's HID_0), which is what the upstream
# Kconfig ships with. Our keyboards need at least one extra slot for the
# HW-75 HID mouse (HID_1) and, when LampArray is enabled, one more for
# the LampArray interface (HID_2 for hw75_keyboard, HID_3 for hw75_dynamic
# — see HW75_LAMPARRAY_DEVICE_NAME above). Without this override, the
# mouse and LampArray SYS_INITs both call device_get_binding() against
# non-existent devices, return -ENODEV, and the descriptors are never
# registered with the USB stack. The host then sees the keyboard
# enumerate but the auxiliary interfaces come up as Code 10.
config USB_HID_DEVICE_COUNT
	int "Number of USB HID devices (overrides Zephyr default of 1)"
	default 4 if (BOARD_HW75_DYNAMIC && HW75_LAMPARRAY)
	default 3 if (BOARD_HW75_KEYBOARD && HW75_LAMPARRAY)
	default 3 if BOARD_HW75_DYNAMIC
	default 2 if BOARD_HW75_KEYBOARD