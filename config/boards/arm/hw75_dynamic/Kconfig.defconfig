# HW-75 board configuration

# Copyright (c) 2022 The ZMK Contributors
# SPDX-License-Identifier: MIT

if BOARD_HW75_DYNAMIC

config BOARD
	default "hw75_dynamic"

config ZMK_KEYBOARD_NAME
	default "HelloWord HW-75 Dynamic"

config ZMK_USB
	default y

# USB_HID_DEVICE_COUNT is set in app/Kconfig.lamparray, branching on
# HW75_LAMPARRAY. Pinning it here would silently override the LampArray
# value and cause the new HID_3 device to fail to register.

rsource "Kconfig.display"
rsource "Kconfig.rgb"
rsource "Kconfig.uf2"
rsource "Kconfig.usb"

rsource "app/Kconfig"

endif # BOARD_HW75_DYNAMIC
