# Clock & pin
CONFIG_CLOCK_CONTROL=y
CONFIG_PINCTRL=y

# RGB
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=n
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=y
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX=15
CONFIG_HW75_INDICATOR_BRIGHTNESS_ACTIVE=255
CONFIG_HW75_INDICATOR_BRIGHTNESS_INACTIVE=10

# Storage
CONFIG_FLASH=y
CONFIG_FLASH_MAP=y
CONFIG_NVS=y
CONFIG_SETTINGS=y

# System
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_HEAP_MEM_POOL_SIZE=1024

# USB
CONFIG_USB_DEVICE_MANUFACTURER="HelloWord"
CONFIG_USB_DEVICE_PRODUCT="HW-75 Keyboard"
CONFIG_HW75_HID_MOUSE=y
CONFIG_HW75_HID_MOUSE_DEVICE_NAME="HID_1"
# Run zmk_usb_hid_init at APPLICATION/90 (same as our other HID inits)
# instead of the default 95 so HID_0's wDescriptorLength is stamped into
# the static HID class descriptor before usb_enable (priority 94) hands
# the device over to the host. Otherwise the host can read the
# Configuration Descriptor and see wDescriptorLength=0 for the keyboard
# interface, fail to fetch the HID report descriptor, and the device
# enumerates as "Unknown USB Device" on Windows.
CONFIG_ZMK_USB_HID_INIT_PRIORITY=90
